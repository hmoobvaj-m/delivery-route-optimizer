# Application
APP_NAME=delivery-route-optimizer
APP_ENV=dev
LOG_LEVEL=debug

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
WEB_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL/PostGIS
POSTGRES_DB=delivery_routes
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5433

# Local development database URL
# Use this when FastAPI/worker run directly in WSL/Conda.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/delivery_routes

# Docker internal database URL
# Use this later when FastAPI/worker run inside Docker Compose.
DOCKER_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/delivery_routes

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Docker internal Redis URL
DOCKER_REDIS_URL=redis://redis:6379/0

# Queue
OPTIMIZATION_QUEUE_NAME=route-optimization
OPTIMIZATION_JOB_TIMEOUT_SECONDS=300

# OSRM / Routing Engine
OSRM_BASE_URL=http://localhost:5000
OSRM_PROFILE=driving

# Route optimization defaults
DEFAULT_SERVICE_TIME_SECONDS=120
DEFAULT_VEHICLE_CAPACITY=100
DEFAULT_ROUTE_TIME_LIMIT_SECONDS=28800

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000

READINESS_TIMEOUT_SECONDS=2.0